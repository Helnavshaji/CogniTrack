            })}
          </div>

          {/* Mascot */}
          <AlexMascot size={140} state={mascotState} />

          {/* Alex reflects notice */}
          {state === "analyzing" && (
            <motion.div 
              animate={{ scale: [1, 1.03, 1] }}
              transition={{ repeat: Infinity, duration: 1.5, ease: "easeInOut" }}
              style={{
                backgroundColor: 'var(--bg-light)',
                padding: '12px 24px',
                borderRadius: 16,
