          {/* Mic trigger and waveform animations */}
          {state === "question" && !isTyping && (
            <div>
              <button 
                onClick={startRecording} 
                className="btn-press" 
                style={{
                  width: 80, 
                  height: 80, 
                  borderRadius: "50%",
