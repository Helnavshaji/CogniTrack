                  <motion.button 
                    onClick={() => setExpandedTimelineIdx(expandedTimelineIdx === idx ? null : idx)}
                    className="clay-btn-cta"
                    whileHover={{ scale: 1.05 }}
                    whileTap={{ scale: 0.95 }}
                    style={{ padding: '6px 14px', fontSize: '0.75rem', borderBottomWidth: '3px' }}
