}

@keyframes float-bubble-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

.thinking-dot {
  animation: blink-dot 1.4s infinite both;
}
.thinking-dot.d-1 { animation-delay: 0s; }
.thinking-dot.d-2 { animation-delay: 0.2s; }
.thinking-dot.d-3 { animation-delay: 0.4s; }

@keyframes blink-dot {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 1; }
}

@keyframes slideInUp {
  0% { transform: translateY(20px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

/* Custom Scrollbar for Sidebar list */
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
}
.custom-scrollbar::-webkit-scrollbar-track {
