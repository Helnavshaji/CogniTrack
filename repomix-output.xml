          }}
          whileHover={{ y: -9, scale: 1.03, boxShadow: "0 15px 25px rgba(157, 123, 255, 0.08)" }}
          whileTap={{ scale: 0.97 }}
          style={{ 
            padding: '24px 20px', 
            backgroundColor: '#FDF4FF', 
            border: '3px solid #FFFFFF',
            display: 'flex',
            flexDirection: 'column',
            alignItems: 'center',
