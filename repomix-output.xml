        className="clay-card"
        initial={{ opacity: 0, y: 30, scale: 0.98 }}
        animate={{ opacity: 1, y: 0, scale: 1 }}
        transition={{ type: "spring", stiffness: 180, damping: 20 }}
        whileHover={{ y: -6, boxShadow: "0 22px 35px rgba(157, 123, 255, 0.12)" }}
        style={{
