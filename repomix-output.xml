  opacity: 0;
}

.part-heart.h-1 { left: 15%; top: 40%; animation-delay: 0s; }
.part-heart.h-2 { right: 15%; top: 30%; animation-delay: 0.8s; }
.part-heart.h-3 { left: 45%; top: 10%; animation-delay: 1.6s; }

.part-star.st-1 { left: 12%; top: 35%; animation-delay: 0s; }
.part-star.st-2 { right: 12%; top: 40%; animation-delay: 0.9s; }
.part-star.st-3 { left: 50%; top: 12%; animation-delay: 1.5s; }

.part-sparkle.sp-1 { left: 20%; top: 45%; animation: float-up-fade 2.2s infinite ease-out, spin-sparkle 3s infinite linear; }
.part-sparkle.sp-2 { right: 20%; top: 25%; animation: float-up-fade 2.2s infinite ease-out, spin-sparkle 2.5s infinite linear; animation-delay: 0.7s; }
.part-sparkle.sp-3 { left: 40%; top: 15%; animation: float-up-fade 2.2s infinite ease-out, spin-sparkle 3.5s infinite linear; animation-delay: 1.4s; }

/* Mic pulse ring */
.audio-wave-ring {
  position: absolute;
  border-radius: 50%;
  border: 3px solid var(--primary-lavender);
  width: 110px;
  height: 110px;
  z-index: 1;
  opacity: 0.3;
}
.audio-wave-ring.ring-1 {
  animation: pulse-ring 2.2s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
}
.audio-wave-ring.ring-2 {
  animation: pulse-ring 2.2s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
  animation-delay: 1.1s;
}

@keyframes pulse-ring {
  0% { transform: scale(0.85); opacity: 0.7; }
  100% { transform: scale(1.5); opacity: 0; }
}

/* Thinking float bubble */
.thinking-bubble {
  position: absolute;
  top: -15px;
  background: white;
  border: 3px solid var(--primary-lavender);
  padding: 6px 14px;
  border-radius: 16px;
