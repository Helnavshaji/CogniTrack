<file path="frontend/src/index.css">
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&family=Caveat:wght@400;700&family=League+Script&display=swap');

:root {
  --bg-light: #F6F0FF;
  --bg-card: #FFFFFF;
  
  /* Pastel Palette from Design Specification */
  --primary-lavender: #BFA2FF;
  --secondary-purple: #9D7BFF;
  --soft-pink: #FFD6E7;
  --cream: #FFF8F2;
  --pastel-blue: #DDEEFF;
  --pastel-yellow: #FFF1B8;
  --soft-green: #D8F5D0;
  
  /* Text and details */
  --text-primary: #2C2C4E;
  --text-secondary: #48486A;
  --border-glass: rgba(255, 255, 255, 0.7);
  
  --font-heading: 'Poppins', system-ui, sans-serif;
  --font-body: 'Caveat', 'League Script', cursive;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-light);
  color: var(--text-primary);
  font-family: var(--font-body);
  min-height: 100vh;
  overflow-x: hidden;
  position: relative;
}

#root {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.3px;
}

/* Claymorphism Cards */
.clay-card {
  background: var(--bg-card);
  border-radius: 24px;
  border: 3px solid #FFFFFF;
  box-shadow: 0 10px 25px rgba(157, 123, 255, 0.07),
              inset 3px 3px 5px rgba(255, 255, 255, 0.9),
              inset -3px -3px 5px rgba(157, 123, 255, 0.04);
  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s ease;
}
.clay-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 30px rgba(157, 123, 255, 0.1),
              inset 3px 3px 5px rgba(255, 255, 255, 0.9),
              inset -3px -3px 5px rgba(157, 123, 255, 0.04);
}

/* Clay Button CTA (Duolingo-style pressable) */
.clay-btn-cta {
  background: linear-gradient(135deg, var(--primary-lavender) 0%, var(--secondary-purple) 100%);
  color: white;
  border-radius: 20px;
  border: none;
  border-bottom: 5px solid #845ef7;
  font-family: var(--font-heading);
  font-weight: 700;
  padding: 14px 28px;
  box-shadow: 0 6px 15px rgba(157, 123, 255, 0.15);
  transition: all 0.1s ease;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  outline: none;
  text-decoration: none;
}
.clay-btn-cta:hover {
  transform: translateY(1px);
  border-bottom-width: 4px;
  box-shadow: 0 4px 10px rgba(157, 123, 255, 0.15);
}
.clay-btn-cta:active {
  transform: translateY(4px);
  border-bottom-width: 0px;
  box-shadow: 0 2px 4px rgba(157, 123, 255, 0.1);
}

/* Clay Button Navigation */
.clay-btn-nav {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  border-radius: 20px;
  color: var(--text-secondary);
  text-decoration: none;
  font-weight: 600;
  font-family: var(--font-heading);
  transition: all 0.2s ease;
  border: 3px solid transparent;
  cursor: pointer;
  background: transparent;
  outline: none;
}
.clay-btn-nav:hover {
  color: var(--secondary-purple);
  background: rgba(157, 123, 255, 0.04);
}
.clay-btn-nav.active {
  background: var(--primary-lavender);
  color: white;
  box-shadow: 0 6px 12px rgba(157, 123, 255, 0.12),
              inset 2px 2px 4px rgba(255, 255, 255, 0.4);
  border-bottom: 4px solid var(--secondary-purple);
}

/* Clay Inputs */
.clay-input {
  width: 100%;
  padding: 14px 20px;
  border-radius: 18px;
  border: 3px solid #FFFFFF;
  background: var(--bg-light);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-weight: 500;
  box-shadow: inset 2px 2px 5px rgba(157, 123, 255, 0.05),
              inset -2px -2px 5px rgba(255, 255, 255, 0.8),
              0 2px 5px rgba(157, 123, 255, 0.02);
  outline: none;
  transition: border-color 0.2s;
}
.clay-input:focus {
  border-color: var(--primary-lavender);
}

/* Cloud Floating Background Elements */
.bg-clouds {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.cloud {
  position: absolute;
  background: white;
  border-radius: 100px;
  opacity: 0.5;
  filter: blur(4px);
  animation: float-cloud 40s infinite linear;
}
.cloud::before, .cloud::after {
  content: '';
  position: absolute;
  background: white;
  border-radius: 50%;
}
.cloud-1 {
  width: 150px;
  height: 50px;
  top: 15%;
  left: -200px;
  animation-duration: 45s;
}
.cloud-2 {
  width: 200px;
  height: 60px;
  top: 60%;
  left: -250px;
  animation-duration: 60s;
  animation-delay: 10s;
}

@keyframes float-cloud {
  0% { transform: translateX(0); }
  100% { transform: translateX(calc(100vw + 300px)); }
}

/* Mascot Keyframe Animations & Particles */
@keyframes blink {
  0%, 90%, 100% { transform: scaleY(1); }
  95% { transform: scaleY(0.1); }
}

@keyframes speak {
  0%, 100% { transform: scaleY(0.4); }
